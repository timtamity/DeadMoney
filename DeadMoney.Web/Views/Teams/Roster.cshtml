@model IEnumerable<DeadMoney.Core.Entities.Player>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <img src="@ViewBag.TeamLogo" style="height: 80px;" class="me-4" />
        <div>
            <h1 class="mb-0">@ViewBag.TeamName Roster</h1>
            <span class="badge" style="background-color: @ViewBag.TeamColor">@Model.Count() Players</span>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var player in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card shadow-sm h-100 border-0" style="border-left: 4px solid @ViewBag.TeamColor !important;">
                    <div class="card-body d-flex align-items-center">
                        <img src="https://sleepercdn.com/content/nfl/players/@(player.SleeperId).jpg"
                             class="rounded-circle border me-3"
                             style="width: 50px; height: 50px; object-fit: cover; background-color: #eee;"
                             onerror="this.src='/images/default-player.png'" />
                        <div>
                            <div class="fw-bold">@player.FirstName @player.LastName</div>
                            <small class="text-muted">#@player.Number | @player.PositionCode</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>