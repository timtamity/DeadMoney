@model DeadMoney.Core.Entities.Player

<div class="player-detail-wrapper" style="background: linear-gradient(180deg, @Model.Team?.PrimaryColor 0%, #f8f9fa 100%); padding-top: 50px;">
    <div class="container">
        <div class="row align-items-end">
            <div class="col-md-3 text-center">
                <img src="https://sleepercdn.com/content/nfl/players/@(Model.SleeperId).jpg"
                     class="img-fluid rounded border bg-white shadow" style="max-width: 250px;" />
            </div>
            <div class="col-md-9 pb-3 text-white">
                <h1 class="display-3 fw-bold">#@Model.Number @Model.FirstName @Model.LastName</h1>
                <h3>@Model.PositionCode | @(Model.Team?.Name ?? "Free Agent")</h3>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">Bio Information</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>College:</strong> @Model.College</li>
                    <li class="list-group-item"><strong>Age:</strong> @Model.Age</li>
                    <li class="list-group-item"><strong>Height/Weight:</strong> @Model.Height, @Model.Weight lbs</li>
                    <li class="list-group-item"><strong>Experience:</strong> @(Model.YearsExp == "0" ? "Rookie" : $"{Model.YearsExp} Years")</li>
                </ul>
            </div>
        </div>
        <div class="col-md-8">
            <div class="alert alert-info">Stats integration coming in the next phase!</div>
        </div>
    </div>
</div>