@page "/transactions"
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<DeadMoney.Data.DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject TransactionFeedService FeedSvc

<PageTitle>Transactions — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Transactions</h1>
        @if (transactions != null)
        {
            <div class="subtitle">@totalCount transactions &middot; page @currentPage of @totalPages</div>
        }
    </div>
</div>

<div class="filter-bar bento-card mb-4">
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <label>Search Player</label>
            <input type="text" class="form-control" placeholder="Player name..."
                   value="@searchName" @oninput="@(e => OnSearchInput(e.Value?.ToString() ?? ""))" />
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label>Type</label>
            <select class="form-select" @bind="filterType" @bind:after="OnFilterChanged">
                <option value="">All Types</option>
                <option value="Cut">Cut</option>
                <option value="Signed">Signed</option>
                <option value="Extended">Extended</option>
                <option value="Traded">Traded</option>
                <option value="PickGranted">Pick Granted</option>
                <option value="PickForfeited">Pick Forfeited</option>
            </select>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label>Team</label>
            <select class="form-select" @bind="filterTeam" @bind:after="OnFilterChanged">
                <option value="0">All Teams</option>
                @foreach (var t in teams)
                {
                    <option value="@t.Id">@t.Abbreviation — @t.City</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-3 col-lg-2">
            <label>Position</label>
            <select class="form-select" @bind="filterPosition" @bind:after="OnFilterChanged">
                <option value="">All Positions</option>
                @foreach (var p in positions)
                {
                    <option value="@p.Id">@p.Code</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-3 col-lg-3">
            <label>Per page</label>
            <select class="form-select" @bind="pageSize" @bind:after="OnPageSizeChanged">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@if (transactions == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading transactions...
    </div>
}
else if (!transactions.Any())
{
    <div class="empty-state">
        <i class="bi bi-megaphone"></i>
        <p>No transactions found matching your filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="dm-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Pos</th>
                    <th>Type</th>
                    <th>Team</th>
                    <th class="d-none d-md-table-cell">Details</th>
                    <th class="text-end">When</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in transactions)
                {
                    <tr class="row-link" @onclick="@(() => GoToTransaction(t.Id))">
                        <td>
                            @if (t.Player != null)
                            {
                                <span class="t-name">@t.Player.FirstName @t.Player.LastName</span>
                            }
                            else
                            {
                                <span class="t-name" style="color: var(--dm-gold);">@(t.DraftPick?.Label ?? t.Details ?? "Pick")</span>
                            }
                        </td>
                        <td>
                            @if (t.Player != null)
                            {
                                <span class="@PosBadgeClass(t.Player.Position?.Code)">@(t.Player.Position?.Code ?? "—")</span>
                            }
                            else
                            {
                                <span class="pos-badge" style="background:rgba(201,163,65,0.15);color:var(--dm-gold);">PICK</span>
                            }
                        </td>
                        <td>
                            <span class="txn-badge @TxnClass(t.Type)">@t.Type.ToString().ToUpper()</span>
                        </td>
                        <td class="t-sub">
                            @if (t.ToTeam != null)
                            {
                                @t.Team?.Abbreviation <span style="color: var(--dm-text-muted);">→</span> @t.ToTeam.Abbreviation
                            }
                            else
                            {
                                @(t.Team?.Abbreviation ?? "—")
                            }
                        </td>
                        <td class="t-sub d-none d-md-table-cell">@(t.Details ?? "—")</td>
                        <td class="text-end t-sub">@Relative(t.OccurredAt)</td>
                        <td class="text-end">
                            <button class="dm-btn-ghost dm-btn-sm" @onclick:stopPropagation="true"
                                    @onclick="@(() => GoToTransaction(t.Id))">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
        <div class="dm-pagination">
            <button @onclick="@(async () => await SetPage(1))" disabled="@(currentPage == 1)">«</button>
            <button @onclick="@(async () => await SetPage(currentPage - 1))" disabled="@(currentPage == 1)">‹</button>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                int p = i;
                <button class="@(currentPage == p ? "active" : "")" @onclick="@(async () => await SetPage(p))">@p</button>
            }
            <button @onclick="@(async () => await SetPage(currentPage + 1))" disabled="@(currentPage == totalPages)">›</button>
            <button @onclick="@(async () => await SetPage(totalPages))" disabled="@(currentPage == totalPages)">»</button>
        </div>
    </div>
}

@code {
    private List<DeadMoney.Core.Entities.Transaction>? transactions;
    private List<DeadMoney.Core.Entities.Team> teams = new();
    private List<DeadMoney.Core.Entities.Position> positions = new();
    private Timer? _debounce;

    private string searchName    = "";
    private string filterType    = "";
    private int    filterTeam;
    private int?   filterPosition;
    private int    currentPage   = 1;
    private int    pageSize      = 25;
    private int    totalCount    = 0;
    private int    totalPages    = 1;

    protected override async Task OnInitializedAsync()
    {
        FeedSvc.OnChange += OnFeedChanged;

        using var db = await DbFactory.CreateDbContextAsync();
        teams     = await db.Teams.OrderBy(t => t.Abbreviation).AsNoTracking().ToListAsync();
        positions = await db.Positions.OrderBy(p => p.DisplayOrder).AsNoTracking().ToListAsync();
        await LoadAsync();
    }

    private async void OnFeedChanged()
    {
        currentPage = 1;
        await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private void OnSearchInput(string value)
    {
        searchName = value;
        _debounce?.Dispose();
        _debounce = new Timer(_ => InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadAsync();
            StateHasChanged();
        }), null, 300, Timeout.Infinite);
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Transactions
            .Include(t => t.Player).ThenInclude(p => p!.Position)
            .Include(t => t.Team)
            .Include(t => t.ToTeam)
            .Include(t => t.DraftPick)
            .AsNoTracking()
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchName))
            query = query.Where(t =>
                t.Player != null && (
                EF.Functions.Like(t.Player!.FirstName, $"%{searchName}%") ||
                EF.Functions.Like(t.Player!.LastName,  $"%{searchName}%")));

        if (!string.IsNullOrEmpty(filterType) && Enum.TryParse<TransactionType>(filterType, out var txType))
            query = query.Where(t => t.Type == txType);

        if (filterTeam > 0)
            query = query.Where(t => t.TeamId == filterTeam || t.ToTeamId == filterTeam);

        if (filterPosition.HasValue)
            query = query.Where(t => t.Player != null && t.Player.PositionId == filterPosition);

        totalCount = await query.CountAsync();
        totalPages = Math.Max(1, (totalCount + pageSize - 1) / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;

        transactions = await query
            .OrderByDescending(t => t.OccurredAt)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private async Task SetPage(int page)
    {
        if (page >= 1 && page <= totalPages) { currentPage = page; await LoadAsync(); }
    }

    private void GoToTransaction(int id) => Navigation.NavigateTo($"/transactions/{id}");

    public void Dispose()
    {
        FeedSvc.OnChange -= OnFeedChanged;
        _debounce?.Dispose();
    }

    private static string TxnClass(TransactionType t) => t switch
    {
        TransactionType.Cut           => "txn-cut",
        TransactionType.Signed        => "txn-signed",
        TransactionType.Extended      => "txn-extended",
        TransactionType.Traded        => "txn-traded",
        TransactionType.PickGranted   => "txn-signed",
        TransactionType.PickForfeited => "txn-cut",
        _                             => ""
    };

    private static string Relative(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }
}
