@page "/contracts"
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<DeadMoney.Data.DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Contracts — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Active Contracts</h1>
        @if (contracts != null)
        {
            <div class="subtitle">@totalContracts contracts &middot; page @currentPage of @totalPages</div>
        }
    </div>
</div>

<div class="filter-bar bento-card mb-4">
    <div class="row g-3">
        <div class="col-12 col-sm-4">
            <label>Search Player</label>
            <input type="text" class="form-control" placeholder="Player name..."
                   value="@searchName" @oninput="@(e => OnSearchInput(e.Value?.ToString() ?? ""))" />
        </div>
        <div class="col-6 col-sm-4">
            <label>Team</label>
            <select class="form-select" @bind="filterTeam" @bind:after="OnFilterChanged">
                <option value="">All Teams</option>
                @foreach (var team in teams)
                {
                    <option value="@team.Abbreviation">@team.Abbreviation — @team.City</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-4">
            <label>Min Value</label>
            <input type="number" class="form-control" placeholder="0" @bind="minValue" @bind:after="OnFilterChanged" />
        </div>
    </div>
</div>

@if (contracts == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading contracts...
    </div>
}
else if (!contracts.Any())
{
    <div class="empty-state">
        <i class="bi bi-file-earmark-text"></i>
        <p>No contracts found matching your filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="dm-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick="@(async () => await SortAndLoad("Player"))">Player @GetSortIndicator("Player")</th>
                    <th class="sortable" @onclick="@(async () => await SortAndLoad("Team"))">Team @GetSortIndicator("Team")</th>
                    <th class="sortable" style="text-align:right;" @onclick="@(async () => await SortAndLoad("Value"))">Total Value @GetSortIndicator("Value")</th>
                    <th style="text-align:right;" class="d-none d-md-table-cell">Guaranteed</th>
                    <th style="text-align:right;" class="d-none d-lg-table-cell">Signing Bonus</th>
                    <th style="text-align:center;" class="d-none d-sm-table-cell">Yrs</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in contracts)
                {
                    <tr class="row-link" @onclick="@(() => GoToContract(c.Id))">
                        <td>
                            <span class="t-name">@c.Player?.FirstName @c.Player?.LastName</span>
                            @if (c.IsModifiedBySim)
                            {
                                <span class="sim-tag" title="Modified by sim">✦</span>
                            }
                        </td>
                        <td class="t-sub">
                            @(c.ContractYears.FirstOrDefault()?.Team?.Abbreviation ?? c.Player?.Team?.Abbreviation ?? "FA")
                        </td>
                        <td class="text-end t-money">@FormatMoney(c.TotalValue)</td>
                        <td class="text-end d-none d-md-table-cell">@FormatMoney(c.TotalGuaranteed)</td>
                        <td class="text-end d-none d-lg-table-cell">@FormatMoney(c.SigningBonus)</td>
                        <td class="text-center d-none d-sm-table-cell">
                            <span class="t-name">@c.ContractYears.Count(y => !y.IsVoidYear)</span>
                        </td>
                        <td class="text-end">
                            <button class="dm-btn-ghost dm-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => GoToContract(c.Id))">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
        <div class="dm-pagination">
            <button @onclick="@(async () => await SetPage(1))" disabled="@(currentPage == 1)">«</button>
            <button @onclick="@(async () => await SetPage(currentPage - 1))" disabled="@(currentPage == 1)">‹</button>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                int pageNum = i;
                <button class="@(currentPage == pageNum ? "active" : "")" @onclick="@(async () => await SetPage(pageNum))">@pageNum</button>
            }
            <button @onclick="@(async () => await SetPage(currentPage + 1))" disabled="@(currentPage == totalPages)">›</button>
            <button @onclick="@(async () => await SetPage(totalPages))" disabled="@(currentPage == totalPages)">»</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span style="font-size: 0.8rem; color: var(--dm-text-muted);">Per page:</span>
            <select class="form-select form-select-sm w-auto" @bind="pageSize" @bind:after="OnPageSizeChangedAsync">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
}

@code {
    private List<DeadMoney.Core.Entities.Contract>? contracts;
    private List<DeadMoney.Core.Entities.Team> teams = new();
    private Timer? _debounceTimer;

    private string searchName = "";
    private string filterTeam = "";
    private decimal minValue = 0;
    private string sortColumn = "Value";
    private bool sortAscending = false;
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalContracts = 0;
    private int totalPages = 0;

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        teams = await db.Teams.OrderBy(t => t.Abbreviation).AsNoTracking().ToListAsync();
        await LoadContractsAsync();
    }

    private void OnSearchInput(string value)
    {
        searchName = value;
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadContractsAsync();
            StateHasChanged();
        }), null, 300, Timeout.Infinite);
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Contracts
            .Where(c => c.IsActive)
            .Include(c => c.Player).ThenInclude(p => p.Team)
            .Include(c => c.ContractYears).ThenInclude(cy => cy.Team)
            .AsNoTracking()
            .AsQueryable();

        if (!string.IsNullOrEmpty(searchName))
            query = query.Where(c =>
                EF.Functions.Like(c.Player.FirstName, $"%{searchName}%") ||
                EF.Functions.Like(c.Player.LastName, $"%{searchName}%"));

        if (!string.IsNullOrEmpty(filterTeam))
            query = query.Where(c =>
                c.ContractYears.Any(cy => cy.Team != null && cy.Team.Abbreviation == filterTeam) ||
                (c.Player.Team != null && c.Player.Team.Abbreviation == filterTeam));

        if (minValue > 0)
            query = query.Where(c => c.TotalValue >= minValue);

        totalContracts = await query.CountAsync();
        totalPages = Math.Max(1, (totalContracts + pageSize - 1) / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;

        query = sortColumn switch
        {
            "Player" => sortAscending ? query.OrderBy(c => c.Player.LastName).ThenBy(c => c.Player.FirstName) : query.OrderByDescending(c => c.Player.LastName).ThenByDescending(c => c.Player.FirstName),
            "Team"   => sortAscending ? query.OrderBy(c => c.Player.Team != null ? c.Player.Team.Abbreviation : "") : query.OrderByDescending(c => c.Player.Team != null ? c.Player.Team.Abbreviation : ""),
            _        => sortAscending ? query.OrderBy(c => c.TotalValue) : query.OrderByDescending(c => c.TotalValue)
        };

        contracts = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();
    }

    private async Task SortAndLoad(string column)
    {
        sortAscending = sortColumn == column ? !sortAscending : false;
        sortColumn = column;
        currentPage = 1;
        await LoadContractsAsync();
    }

    private async Task OnPageSizeChangedAsync()
    {
        currentPage = 1;
        await LoadContractsAsync();
    }

    private async Task SetPage(int page)
    {
        if (page >= 1 && page <= totalPages) { currentPage = page; await LoadContractsAsync(); }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortAscending ? " ▲" : " ▼";
    }

    private void GoToContract(int contractId) => Navigation.NavigateTo($"/contracts/{contractId}");
    public void Dispose() => _debounceTimer?.Dispose();

    private void GoToPlayer(int playerId) => Navigation.NavigateTo($"/players/{playerId}");
    private static string FormatMoney(decimal value) => value >= 1_000_000m ? $"${value / 1_000_000m:F1}M" : value >= 1_000m ? $"${value / 1_000m:F0}K" : value.ToString("C0");
}
