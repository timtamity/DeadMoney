@page "/teams"
@inject IDbContextFactory<DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject LeagueSettingsService LeagueSettingsSvc

<PageTitle>Teams — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Teams</h1>
        @if (loaded)
        {
            <div class="subtitle">@currentYear &middot; Cap: $@(salaryCap / 1_000_000m).0M</div>
        }
    </div>
    @if (loaded)
    {
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <input class="form-control" style="max-width:200px;" placeholder="Search…"
                   @bind-value="search" @bind-value:event="oninput" />
            <select class="form-select w-auto" @bind="confFilter">
                <option value="">All</option>
                <option value="AFC">AFC</option>
                <option value="NFC">NFC</option>
            </select>
            <select class="form-select w-auto" @bind="sortMode">
                <option value="div">Division</option>
                <option value="space">Cap Space</option>
                <option value="hit">Cap Hit</option>
                <option value="roster">Roster Size</option>
                <option value="picks">Draft Capital</option>
            </select>
        </div>
    }
</div>

@if (!loaded)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading teams...
    </div>
}
else
{
    <div class="table-responsive bento-card">
        <table class="dm-table">
            <thead>
                <tr>
                    <th>Team</th>
                    <th class="d-none d-sm-table-cell">Conf / Div</th>
                    <th class="text-end">Cap Space</th>
                    <th class="text-end d-none d-md-table-cell">Cap Hit</th>
                    <th class="text-center d-none d-md-table-cell">Roster</th>
                    <th class="text-center d-none d-lg-table-cell">Picks</th>
                    <th class="d-none d-lg-table-cell">Cap Usage</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in FilteredRows)
                {
                    var pct = (salaryCap + row.CarryoverCap) > 0
                        ? Math.Min((double)row.CapHit / (double)(salaryCap + row.CarryoverCap) * 100.0, 100.0)
                        : 0.0;
                    var barClass = pct >= 100 ? "red" : pct >= 85 ? "yellow" : "green";

                    <tr class="row-link" @onclick="@(() => Navigation.NavigateTo($"/teams/{row.TeamId}"))">
                        <td>
                            <span class="t-name" style="color:@(row.PrimaryColor ?? "var(--dm-text-bright)")">@row.Abbreviation</span>
                            <span class="t-meta d-block">@row.City @row.Nickname</span>
                        </td>
                        <td class="t-meta d-none d-sm-table-cell">@row.Conference — @row.Division</td>
                        <td class="text-end @(row.CapSpace < 0 ? "t-danger" : "t-success") fw-bold">
                            @FormatMoney(row.CapSpace)
                        </td>
                        <td class="text-end t-meta d-none d-md-table-cell">@FormatMoney(row.CapHit)</td>
                        <td class="text-center d-none d-md-table-cell">
                            <span class="@(row.RosterCount >= 85 ? "t-success" : row.RosterCount == 0 ? "t-meta" : "")">
                                @row.RosterCount
                            </span>
                            <span class="t-meta">/90</span>
                        </td>
                        <td class="text-center t-meta d-none d-lg-table-cell">@row.PickCount</td>
                        <td class="d-none d-lg-table-cell" style="min-width:100px;">
                            <div class="cap-bar-wrap">
                                <div class="cap-bar-fill @barClass" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                            </div>
                        </td>
                        <td class="text-end">
                            <i class="bi bi-chevron-right t-meta"></i>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private record TeamRow(int TeamId, string Abbreviation, string City, string Nickname,
        string Conference, string Division, string? PrimaryColor,
        decimal CapHit, decimal CarryoverCap, decimal CapSpace,
        int RosterCount, int PickCount);

    private bool         loaded      = false;
    private int          currentYear;
    private decimal      salaryCap;
    private string       search      = "";
    private string       confFilter  = "";
    private string       sortMode    = "div";
    private List<TeamRow> allRows    = new();

    private IEnumerable<TeamRow> FilteredRows
    {
        get
        {
            var q = allRows.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(r =>
                    r.Abbreviation.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    r.City.Contains(search,         StringComparison.OrdinalIgnoreCase) ||
                    r.Nickname.Contains(search,     StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(confFilter))
                q = q.Where(r => r.Conference == confFilter);
            return sortMode switch
            {
                "space"  => q.OrderByDescending(r => r.CapSpace),
                "hit"    => q.OrderByDescending(r => r.CapHit),
                "roster" => q.OrderByDescending(r => r.RosterCount),
                "picks"  => q.OrderByDescending(r => r.PickCount),
                _        => q.OrderBy(r => r.Conference).ThenBy(r => r.Division).ThenBy(r => r.Abbreviation)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var setting = await LeagueSettingsSvc.GetCurrentAsync();
        currentYear = setting?.Year ?? DateTime.UtcNow.Year;
        salaryCap   = setting?.SalaryCap ?? 279_200_000m;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var teams = await db.Teams.AsNoTracking().ToListAsync();

        var capHits = await db.ContractYears
            .Where(cy => cy.Year == currentYear && cy.TeamId != null)
            .GroupBy(cy => cy.TeamId)
            .Select(g => new { TeamId = g.Key!.Value, Total = g.Sum(cy => cy.CapNumber) })
            .ToListAsync();

        var rosterCounts = await db.Players
            .Where(p => p.TeamId != null && !p.IsRetired)
            .GroupBy(p => p.TeamId)
            .Select(g => new { TeamId = g.Key!.Value, Count = g.Count() })
            .ToListAsync();

        var pickCounts = await db.DraftPicks
            .Where(dp => !dp.IsVoided && !dp.IsUsed)
            .GroupBy(dp => dp.CurrentTeamId)
            .Select(g => new { TeamId = g.Key, Count = g.Count() })
            .ToListAsync();

        var hitMap    = capHits.ToDictionary(x => x.TeamId, x => x.Total);
        var rosterMap = rosterCounts.ToDictionary(x => x.TeamId, x => x.Count);
        var pickMap   = pickCounts.ToDictionary(x => x.TeamId, x => x.Count);

        allRows = teams.Select(t =>
        {
            var hit   = hitMap.TryGetValue(t.Id, out var h) ? h : 0m;
            var space = salaryCap + t.CarryoverCap - hit;
            var roster = rosterMap.TryGetValue(t.Id, out var rc) ? rc : 0;
            var picks  = pickMap.TryGetValue(t.Id, out var pc) ? pc : 0;
            return new TeamRow(t.Id, t.Abbreviation, t.City, t.Nickname,
                t.Conference, t.Division, t.PrimaryColor,
                hit, t.CarryoverCap, space, roster, picks);
        }).ToList();
    }
}
