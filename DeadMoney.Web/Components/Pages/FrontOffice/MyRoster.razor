@page "/roster"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@attribute [Authorize(Roles = "Admin, GM, Assistant GM, Commissioner")]
@inject IDbContextFactory<DeadMoney.Data.DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CapEngineService CapEngine
@inject RosterService RosterService
@inject LeagueSettingsService LeagueSettingsSvc

<PageTitle>My Roster — Dead Money</PageTitle>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading roster...
    </div>
}
else if (team == null)
{
    <div class="empty-state mt-4">
        <i class="bi bi-exclamation-circle"></i>
        <p>No team assigned to your account. Contact the commissioner.</p>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>@team.Abbreviation <span style="font-weight: 400; font-size: 1.1rem;">@team.City @team.Name</span></h1>
            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                <span class="conf-badge @(team.Conference == "AFC" ? "afc" : "nfc")">
                    @team.Conference — @team.Division
                </span>
                <span class="t-tiny">@selectedYear roster</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (isCommissioner)
            {
                <label class="t-tiny mb-0 d-none d-sm-inline">View Team:</label>
                <select class="form-select w-auto" @bind="selectedTeamId" @bind:after="OnTeamChanged">
                    @foreach (var t in allTeams)
                    {
                        <option value="@t.Id">@t.Abbreviation — @t.City</option>
                    }
                </select>
            }
            <button class="dm-btn-outline" @onclick="ToggleSignPanel">
                <i class="bi bi-person-plus me-1"></i> Sign FA
            </button>
        </div>
    </div>

    <div class="dm-tabs">
        @foreach (var y in availableYears)
        {
            int year = y;
            <button class="dm-tab @(selectedYear == year ? "active" : "")"
                    @onclick="@(async () => await SelectYearAsync(year))">@year</button>
        }
    </div>

    <div class="stats-row mb-4">
        <div class="stat-card">
            <div class="stat-label">Total Cap Hit</div>
            <div class="stat-value gold">@FormatMoney(totalCapHit)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Dead Money</div>
            <div class="stat-value @(deadMoney > 0 ? "red" : "")">@FormatMoney(deadMoney)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Cap Space</div>
            <div class="stat-value @(capSpace < 0 ? "red" : "green")">@FormatMoney(capSpace)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Carryover</div>
            <div class="stat-value green" style="font-size: 1.1rem;">@FormatMoney(team.CarryoverCap)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Roster Size</div>
            <div class="stat-value">@roster.Count</div>
        </div>
    </div>

    @if (_showSignPanel)
    {
        <div class="bento-card mb-4" style="border-color: rgba(88, 166, 255, 0.4);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-title mb-0">Sign Free Agent</h2>
                <button class="dm-btn-ghost dm-btn-sm" @onclick="CloseSignPanel"><i class="bi bi-x-lg"></i></button>
            </div>

            @if (_playerToSign == null)
            {
                <div class="d-flex gap-2 mb-3">
                    <input type="text" class="form-control" placeholder="Search player name..."
                           @bind="_signSearch" @bind:event="oninput"
                           @onkeyup="@(async e => { if (e.Key == "Enter") await SearchFreeAgentsAsync(); })" />
                    <button class="dm-btn-outline" @onclick="SearchFreeAgentsAsync">Search</button>
                </div>

                @if (_signSearchResults != null && !_signSearchResults.Any())
                {
                    <div class="t-sub">No free agents found matching "@_signSearch".</div>
                }
                else if (_signSearchResults != null)
                {
                    <div class="table-responsive">
                        <table class="dm-table">
                            <thead>
                                <tr>
                                    <th>Player</th>
                                    <th>Pos</th>
                                    <th class="d-none d-sm-table-cell">Age</th>
                                    <th class="d-none d-sm-table-cell">Last Contract</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _signSearchResults)
                                {
                                    var lastContract = p.Contracts.OrderByDescending(c => c.Id).FirstOrDefault();
                                    <tr style="cursor: pointer;" @onclick="@(() => SelectPlayerToSign(p))">
                                        <td><span class="t-name">@p.FirstName @p.LastName</span></td>
                                        <td><span class="@PosBadgeClass(p.Position?.Code)">@(p.Position?.Code ?? "—")</span></td>
                                        <td class="d-none d-sm-table-cell t-sub">@(p.Age.HasValue ? p.Age.ToString() : "—")</td>
                                        <td class="d-none d-sm-table-cell t-sub">@(lastContract != null ? FormatMoney(lastContract.TotalValue) : "—")</td>
                                        <td class="text-end">
                                            <button class="dm-btn-ghost dm-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => SelectPlayerToSign(p))">
                                                Select <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="mb-3 d-flex align-items-center flex-wrap gap-2">
                    <span class="t-name" style="font-size: 1rem;">@_playerToSign.FirstName @_playerToSign.LastName</span>
                    <span class="@PosBadgeClass(_playerToSign.Position?.Code)">@(_playerToSign.Position?.Code ?? "—")</span>
                    <button class="dm-btn-ghost dm-btn-sm ms-1" @onclick="@(() => _playerToSign = null)">
                        <i class="bi bi-arrow-left me-1"></i>Change Player
                    </button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6 col-sm-3">
                        <label class="t-tiny d-block mb-1">Years</label>
                        <input type="number" class="form-control" min="1" max="10" @bind="_signYears" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="t-tiny d-block mb-1">Total Value ($M)</label>
                        <input type="number" class="form-control" min="0" step="0.1" @bind="_signTotalValueM" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="t-tiny d-block mb-1">Guaranteed ($M)</label>
                        <input type="number" class="form-control" min="0" step="0.1" @bind="_signGuaranteedM" />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="t-tiny d-block mb-1">Signing Bonus ($M)</label>
                        <input type="number" class="form-control" min="0" step="0.1" @bind="_signSigningBonusM" />
                    </div>
                </div>

                @if (_signTotalValueM > 0 && _signYears > 0)
                {
                    <div class="t-tiny mb-3">
                        Cap hit: <span class="t-money">@FormatMoney(_signTotalValueM * 1_000_000m / _signYears)</span> / yr
                        @if (_signSigningBonusM > 0)
                        {
                            <span class="ms-2">· SB proration: @FormatMoney(_signSigningBonusM * 1_000_000m / _signYears) / yr</span>
                        }
                    </div>
                }

                <div class="d-flex gap-2">
                    <button class="dm-btn-outline" @onclick="ConfirmSignAsync"
                            disabled="@(_isSigning || _signYears < 1 || _signTotalValueM <= 0)">
                        @if (_isSigning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Sign @_playerToSign.LastName
                    </button>
                    <button class="dm-btn-ghost" @onclick="CloseSignPanel">Cancel</button>
                </div>
            }
        </div>
    }

    @if (!roster.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p>No players on roster for @selectedYear.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="dm-table">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Pos</th>
                        <th class="text-end">@selectedYear Cap</th>
                        <th class="text-center d-none d-sm-table-cell">Yrs Left</th>
                        <th class="text-end d-none d-md-table-cell">Contract Value</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in roster)
                    {
                        <tr>
                            <td style="cursor: pointer;" @onclick="@(() => GoToPlayer(row.Player.Id))">
                                <span class="t-name">@row.Player.FirstName @row.Player.LastName</span>
                                @if (!string.IsNullOrEmpty(row.Player.Number))
                                {
                                    <span class="t-jersey">#@row.Player.Number</span>
                                }
                            </td>
                            <td><span class="@PosBadgeClass(row.Player.Position?.Code)">@(row.Player.Position?.Code ?? "—")</span></td>
                            <td class="text-end t-money">@(row.CapHit > 0 ? FormatMoney(row.CapHit) : "—")</td>
                            <td class="text-center d-none d-sm-table-cell">
                                <span style="color: @(row.YearsRemaining == 0 ? "var(--dm-danger)" : "var(--dm-text-main)");">
                                    @(row.YearsRemaining == 0 ? "Expiring" : $"{row.YearsRemaining}")
                                </span>
                            </td>
                            <td class="text-end t-sub d-none d-md-table-cell">
                                @(row.Contract != null ? FormatMoney(row.Contract.TotalValue) : "—")
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <button class="dm-btn-ghost dm-btn-sm" title="View player"
                                            @onclick="@(() => GoToPlayer(row.Player.Id))">
                                        <i class="bi bi-person"></i>
                                    </button>
                                    @if (_playerToExtendId == row.Player.Id)
                                    {
                                        <button class="dm-btn-outline dm-btn-sm" @onclick="CancelExtend">Cancel</button>
                                    }
                                    else if (playerToCutId == row.Player.Id)
                                    {
                                        <button class="dm-btn-outline dm-btn-sm" @onclick="CancelCut">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="dm-btn-ghost dm-btn-sm" title="Extend contract"
                                                @onclick="@(() => InitiateExtend(row))">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                        <button class="dm-btn-danger dm-btn-sm" title="Cut player"
                                                @onclick="@(() => InitiateCut(row))">
                                            <i class="bi bi-scissors"></i> Cut
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (playerToCutId == row.Player.Id)
                        {
                            <tr>
                                <td colspan="6" style="padding: 0 1rem 0.75rem;">
                                    <div class="cut-confirm-panel">
                                        <div style="font-weight: 700; color: var(--dm-danger); margin-bottom: 0.75rem;">
                                            <i class="bi bi-scissors me-2"></i>
                                            Cut @row.Player.FirstName @row.Player.LastName?
                                        </div>

                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="postJune1Toggle"
                                                   @bind="_isPostJune1" @bind:after="RecalculateCut" />
                                            <label class="form-check-label t-tiny" for="postJune1Toggle">
                                                Post-June 1 designation — future proration deferred to @(selectedYear + 1)
                                            </label>
                                        </div>

                                        <div class="stats-row mb-3" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));">
                                            <div class="stat-card">
                                                <div class="stat-label">Dead Money (@selectedYear)</div>
                                                <div class="stat-value red" style="font-size: 1rem;">@FormatMoney(deadMoneyEstimate)</div>
                                            </div>
                                            @if (_isPostJune1 && _deadMoneyNextYear > 0)
                                            {
                                                <div class="stat-card">
                                                    <div class="stat-label">Dead Money (@(selectedYear + 1))</div>
                                                    <div class="stat-value t-warn" style="font-size: 1rem;">@FormatMoney(_deadMoneyNextYear)</div>
                                                </div>
                                            }
                                            <div class="stat-card">
                                                <div class="stat-label">Cap Savings</div>
                                                <div class="stat-value green" style="font-size: 1rem;">@FormatMoney(capSavingsEstimate)</div>
                                            </div>
                                        </div>

                                        <p class="t-tiny mb-3">
                                            @if (_isPostJune1)
                                            {
                                                @:Only current-year proration counts against the cap now. Remaining proration accelerates in @(selectedYear + 1).
                                            }
                                            else
                                            {
                                                @:All remaining signing bonus proration accelerates as dead cap in @selectedYear. Future contract years are voided.
                                            }
                                        </p>

                                        <div class="d-flex gap-2">
                                            <button class="dm-btn-danger" @onclick="ConfirmCutAsync" disabled="@isCutting">
                                                @if (isCutting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                Confirm Cut
                                            </button>
                                            <button class="dm-btn-outline" @onclick="CancelCut">Cancel</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (_playerToExtendId == row.Player.Id)
                        {
                            <tr>
                                <td colspan="6" style="padding: 0 1rem 0.75rem;">
                                    <div class="action-panel">
                                        <div style="font-weight: 700; color: var(--dm-accent); margin-bottom: 0.75rem;">
                                            <i class="bi bi-plus-circle me-2"></i>
                                            Extend @row.Player.FirstName @row.Player.LastName
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-6 col-sm-3">
                                                <label class="t-tiny d-block mb-1">Years</label>
                                                <input type="number" class="form-control" min="1" max="10" @bind="_extendYears" />
                                            </div>
                                            <div class="col-6 col-sm-3">
                                                <label class="t-tiny d-block mb-1">Total Value ($M)</label>
                                                <input type="number" class="form-control" min="0" step="0.1" @bind="_extendTotalValueM" />
                                            </div>
                                            <div class="col-6 col-sm-3">
                                                <label class="t-tiny d-block mb-1">Guaranteed ($M)</label>
                                                <input type="number" class="form-control" min="0" step="0.1" @bind="_extendGuaranteedM" />
                                            </div>
                                            <div class="col-6 col-sm-3">
                                                <label class="t-tiny d-block mb-1">Signing Bonus ($M)</label>
                                                <input type="number" class="form-control" min="0" step="0.1" @bind="_extendSigningBonusM" />
                                            </div>
                                        </div>

                                        @if (_extendTotalValueM > 0 && _extendYears > 0)
                                        {
                                            <div class="t-tiny mb-3">
                                                New cap hit: <span class="t-money">@FormatMoney(_extendTotalValueM * 1_000_000m / _extendYears)</span> / yr
                                                · Replaces current contract starting @selectedYear
                                            </div>
                                        }

                                        <div class="d-flex gap-2">
                                            <button class="dm-btn-outline" @onclick="ConfirmExtendAsync"
                                                    disabled="@(_isExtending || _extendYears < 1 || _extendTotalValueM <= 0)">
                                                @if (_isExtending) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                Confirm Extension
                                            </button>
                                            <button class="dm-btn-ghost" @onclick="CancelExtend">Cancel</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const decimal LeagueCapLimit = 279_200_000m;

    private record PlayerCapRow(
        Player Player,
        Contract? Contract,
        decimal CapHit,
        int YearsRemaining);

    private Team? team;
    private List<PlayerCapRow> roster = new();
    private List<Team> allTeams = new();
    private List<int> availableYears = new();
    private bool isLoading = true;
    private bool isCommissioner = false;
    private int selectedTeamId;
    private int selectedYear;

    private decimal totalCapHit;
    private decimal deadMoney;
    private decimal capSpace;

    // Cut flow
    private int? playerToCutId;
    private PlayerCapRow? playerToCutRow;
    private decimal deadMoneyEstimate;
    private decimal capSavingsEstimate;
    private bool isCutting = false;
    private bool _isPostJune1 = false;
    private decimal _deadMoneyNextYear;

    // Sign FA flow
    private bool _showSignPanel = false;
    private string _signSearch = "";
    private List<Player>? _signSearchResults;
    private Player? _playerToSign;
    private int _signYears = 1;
    private decimal _signTotalValueM;
    private decimal _signGuaranteedM;
    private decimal _signSigningBonusM;
    private bool _isSigning = false;

    // Extend flow
    private int? _playerToExtendId;
    private PlayerCapRow? _playerToExtendRow;
    private int _extendYears = 2;
    private decimal _extendTotalValueM;
    private decimal _extendGuaranteedM;
    private decimal _extendSigningBonusM;
    private bool _isExtending = false;

    protected override async Task OnInitializedAsync()
    {
        selectedYear   = await LeagueSettingsSvc.GetCurrentYearAsync();
        availableYears = Enumerable.Range(selectedYear, 3).ToList();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isCommissioner = user.IsInRole("Commissioner");

        if (isCommissioner)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            allTeams = await db.Teams.OrderBy(t => t.Abbreviation).ToListAsync();
        }

        var teamIdStr = user.FindFirst("TeamId")?.Value;
        if (int.TryParse(teamIdStr, out var teamId))
        {
            selectedTeamId = teamId;
            await LoadRosterAsync(teamId);
        }
        else if (isCommissioner && allTeams.Any())
        {
            selectedTeamId = allTeams.First().Id;
            await LoadRosterAsync(selectedTeamId);
        }

        isLoading = false;
    }

    private async Task OnTeamChanged() => await LoadRosterAsync(selectedTeamId);

    private async Task SelectYearAsync(int year)
    {
        selectedYear = year;
        playerToCutId      = null;
        playerToCutRow     = null;
        _playerToExtendId  = null;
        _playerToExtendRow = null;
        _showSignPanel     = false;
        if (team != null) await LoadRosterAsync(team.Id);
    }

    private async Task LoadRosterAsync(int teamId)
    {
        using var db = await DbFactory.CreateDbContextAsync();

        team = await db.Teams.AsNoTracking().FirstOrDefaultAsync(t => t.Id == teamId);
        if (team == null) return;

        var players = await db.Players
            .Where(p => p.TeamId == teamId)
            .Include(p => p.Position)
            .Include(p => p.Contracts).ThenInclude(c => c.ContractYears)
            .AsNoTracking()
            .ToListAsync();

        roster = players.Select(p =>
        {
            var contract = p.Contracts.FirstOrDefault(c => c.IsActive);
            var cy = contract?.ContractYears.FirstOrDefault(y => y.Year == selectedYear);
            var capHit = cy?.CapNumber ?? 0m;
            var yearsRemaining = contract?.ContractYears.Count(y => y.Year >= selectedYear && !y.IsVoidYear) ?? 0;
            return new PlayerCapRow(p, contract, capHit, yearsRemaining);
        })
        .OrderBy(r => r.Player.Position?.DisplayOrder ?? 99)
        .ThenByDescending(r => r.CapHit)
        .ToList();

        totalCapHit = await db.ContractYears
            .Where(cy => cy.TeamId == teamId && cy.Year == selectedYear)
            .SumAsync(cy => (decimal?)cy.CapNumber) ?? 0m;

        var rosterCapHit = roster.Sum(r => r.CapHit);
        deadMoney = Math.Max(0, totalCapHit - rosterCapHit);
        capSpace = LeagueCapLimit + team.CarryoverCap - totalCapHit;
    }

    // ── Cut ──────────────────────────────────────────────────────────────────

    private void InitiateCut(PlayerCapRow row)
    {
        _playerToExtendId  = null;
        _playerToExtendRow = null;
        _showSignPanel     = false;
        playerToCutId      = row.Player.Id;
        playerToCutRow     = row;
        _isPostJune1       = false;
        RecalculateCut();
    }

    private void CancelCut()
    {
        playerToCutId  = null;
        playerToCutRow = null;
    }

    private void RecalculateCut()
    {
        if (playerToCutRow?.Contract == null)
        {
            deadMoneyEstimate  = 0;
            capSavingsEstimate = 0;
            _deadMoneyNextYear = 0;
            return;
        }
        var result         = CapEngine.SimulateCut(playerToCutRow.Contract, selectedYear, _isPostJune1);
        deadMoneyEstimate  = result.DeadMoneyCurrent;
        _deadMoneyNextYear = result.DeadMoneyFuture;
        capSavingsEstimate = result.CapSavings;
    }

    private async Task ConfirmCutAsync()
    {
        if (playerToCutRow == null || team == null) return;
        isCutting = true;

        await RosterService.CutPlayerAsync(playerToCutRow.Player.Id, team.Id, selectedYear, _isPostJune1);

        playerToCutId  = null;
        playerToCutRow = null;
        isCutting      = false;

        await LoadRosterAsync(team.Id);
    }

    // ── Sign FA ───────────────────────────────────────────────────────────────

    private void ToggleSignPanel()
    {
        _showSignPanel = !_showSignPanel;
        if (_showSignPanel)
        {
            playerToCutId      = null;
            playerToCutRow     = null;
            _playerToExtendId  = null;
            _playerToExtendRow = null;
        }
        _signSearch        = "";
        _signSearchResults = null;
        _playerToSign      = null;
    }

    private void CloseSignPanel()
    {
        _showSignPanel     = false;
        _signSearch        = "";
        _signSearchResults = null;
        _playerToSign      = null;
    }

    private async Task SearchFreeAgentsAsync()
    {
        if (string.IsNullOrWhiteSpace(_signSearch)) { _signSearchResults = null; return; }

        using var db = await DbFactory.CreateDbContextAsync();
        _signSearchResults = await db.Players
            .Where(p => p.TeamId == null && !p.IsRetired &&
                (EF.Functions.Like(p.FirstName, $"%{_signSearch}%") ||
                 EF.Functions.Like(p.LastName,  $"%{_signSearch}%")))
            .Include(p => p.Position)
            .Include(p => p.Contracts)
            .OrderBy(p => p.LastName)
            .Take(10)
            .AsNoTracking()
            .ToListAsync();
    }

    private void SelectPlayerToSign(Player p)
    {
        _playerToSign      = p;
        _signYears         = 1;
        _signTotalValueM   = 0;
        _signGuaranteedM   = 0;
        _signSigningBonusM = 0;
    }

    private async Task ConfirmSignAsync()
    {
        if (_playerToSign == null || team == null) return;
        _isSigning = true;

        await RosterService.SignFreeAgentAsync(_playerToSign.Id, team.Id, selectedYear,
            new ContractInput(_signYears, _signTotalValueM, _signGuaranteedM, _signSigningBonusM));

        _showSignPanel = false;
        _playerToSign  = null;
        _isSigning     = false;

        await LoadRosterAsync(team.Id);
    }

    // ── Extend ────────────────────────────────────────────────────────────────

    private void InitiateExtend(PlayerCapRow row)
    {
        playerToCutId      = null;
        playerToCutRow     = null;
        _showSignPanel     = false;
        _playerToExtendId  = row.Player.Id;
        _playerToExtendRow = row;
        _extendYears       = 2;
        _extendTotalValueM  = 0;
        _extendGuaranteedM  = 0;
        _extendSigningBonusM = 0;
    }

    private void CancelExtend()
    {
        _playerToExtendId  = null;
        _playerToExtendRow = null;
    }

    private async Task ConfirmExtendAsync()
    {
        if (_playerToExtendRow == null || team == null) return;
        _isExtending = true;

        await RosterService.ExtendPlayerAsync(_playerToExtendRow.Player.Id, team.Id, selectedYear,
            new ContractInput(_extendYears, _extendTotalValueM, _extendGuaranteedM, _extendSigningBonusM));

        _playerToExtendId  = null;
        _playerToExtendRow = null;
        _isExtending       = false;

        await LoadRosterAsync(team.Id);
    }

    private void GoToPlayer(int id) => Navigation.NavigateTo($"/players/{id}");
    private static string FormatMoney(decimal v) => v >= 1_000_000m ? $"${v / 1_000_000m:F1}M" : v >= 1_000m ? $"${v / 1_000m:F0}K" : v <= -1_000_000m ? $"-${Math.Abs(v) / 1_000_000m:F1}M" : v.ToString("C0");
}
