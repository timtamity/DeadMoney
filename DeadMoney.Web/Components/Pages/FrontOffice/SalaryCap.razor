@page "/salary-cap"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IDbContextFactory<DeadMoney.Data.DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject LeagueSettingsService LeagueSettingsSvc

<PageTitle>Salary Cap — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Salary Cap</h1>
        <div class="subtitle">@selectedYear league-wide overview &middot; Cap limit: @FormatMoney(leagueCapLimit)</div>
    </div>
    <select class="form-select w-auto" value="@selectedYear" @onchange="OnYearChanged">
        @foreach (var y in availableYears)
        {
            <option value="@y">@y</option>
        }
    </select>
</div>

@if (teamCapData == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading cap data...
    </div>
}
else
{
    <div class="stats-row mb-4">
        <div class="stat-card">
            <div class="stat-label">League Cap</div>
            <div class="stat-value gold">@FormatMoney(leagueCapLimit)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Teams Over Cap</div>
            <div class="stat-value @(teamsOverCap > 0 ? "red" : "green")">@teamsOverCap</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Avg Cap Used</div>
            <div class="stat-value" style="font-size: 1.1rem;">
                @(teamCapData.Any() ? FormatMoney(teamCapData.Average(t => t.CapHit)) : "—")
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Most Cap Space</div>
            <div class="stat-value green" style="font-size: 1.1rem;">
                @(teamCapData.Any() ? teamCapData.OrderByDescending(t => t.CapSpace).First().Team.Abbreviation : "—")
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="dm-table">
            <thead>
                <tr>
                    <th>Team</th>
                    <th class="d-none d-sm-table-cell">Conference</th>
                    <th style="text-align:right;">Cap Hit</th>
                    <th style="text-align:right;" class="d-none d-md-table-cell">Carryover</th>
                    <th style="text-align:right;">Cap Space</th>
                    <th style="min-width: 120px;" class="d-none d-md-table-cell">Usage</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in teamCapData.OrderByDescending(t => t.CapSpace))
                {
                    var pct = row.TotalCap > 0 ? Math.Min((double)row.CapHit / (double)row.TotalCap * 100.0, 100.0) : 0.0;
                    var barClass    = pct >= 100 ? "red"  : pct >= 85 ? "yellow" : "green";
                    var badgeClass  = pct >= 100 ? "over" : pct >= 85 ? "tight"  : "good";
                    <tr style="cursor: pointer;" @onclick="@(() => GoToTeam(row.Team.Id))">
                        <td>
                            <div class="t-name">@row.Team.Abbreviation</div>
                            <div class="t-tiny">@row.Team.City @row.Team.Name</div>
                        </td>
                        <td class="d-none d-sm-table-cell">
                            <span class="conf-badge @(row.Team.Conference == "AFC" ? "afc" : "nfc")">
                                @row.Team.Conference &mdash; @row.Team.Division
                            </span>
                        </td>
                        <td style="text-align:right; color: var(--dm-text-bright); font-weight: 600;">
                            @FormatMoney(row.CapHit)
                        </td>
                        <td style="text-align:right; color: var(--dm-success);" class="d-none d-md-table-cell">
                            @(row.Team.CarryoverCap > 0 ? $"+{FormatMoney(row.Team.CarryoverCap)}" : "—")
                        </td>
                        <td style="text-align:right;">
                            <span class="cap-badge @badgeClass">@FormatMoney(row.CapSpace)</span>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <div class="cap-bar-wrap">
                                <div class="cap-bar-fill @barClass" style="width: @(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                            </div>
                            <div style="font-size: 0.7rem; color: var(--dm-text-muted); margin-top: 3px;">
                                @(pct.ToString("F0"))% used
                            </div>
                        </td>
                        <td style="text-align:right;">
                            <button class="dm-btn-ghost dm-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => GoToTeam(row.Team.Id))">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private record TeamCapRow(DeadMoney.Core.Entities.Team Team, decimal CapHit, decimal CapSpace, decimal TotalCap);

    private List<TeamCapRow>? teamCapData;
    private List<int> availableYears = new();
    private int selectedYear;
    private int teamsOverCap;
    private decimal leagueCapLimit;

    protected override async Task OnInitializedAsync()
    {
        var setting = await LeagueSettingsSvc.GetCurrentAsync();
        selectedYear    = setting?.Year ?? DateTime.UtcNow.Year;
        leagueCapLimit  = setting?.SalaryCap ?? 279_200_000m;

        using var db = await DbFactory.CreateDbContextAsync();
        var years = await db.ContractYears
            .Select(cy => cy.Year)
            .Distinct()
            .OrderByDescending(y => y)
            .ToListAsync();

        availableYears = years.Any() ? years : new List<int> { selectedYear };
        if (!availableYears.Contains(selectedYear) && availableYears.Any())
            selectedYear = availableYears.First();

        await LoadCapDataAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e?.Value?.ToString(), out var y))
        {
            selectedYear = y;
            await LoadCapDataAsync();
        }
    }

    private async Task LoadCapDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var teams = await db.Teams.AsNoTracking().ToListAsync();

        var capByTeam = await db.ContractYears
            .Where(cy => cy.Year == selectedYear && cy.TeamId != null)
            .GroupBy(cy => cy.TeamId!.Value)
            .Select(g => new { TeamId = g.Key, CapHit = g.Sum(cy => cy.CapNumber) })
            .ToListAsync();

        teamCapData = teams.Select(t =>
        {
            var cap = capByTeam.FirstOrDefault(c => c.TeamId == t.Id);
            var capHit   = cap?.CapHit ?? 0m;
            var totalCap = leagueCapLimit + t.CarryoverCap;
            var capSpace = totalCap - capHit;
            return new TeamCapRow(t, capHit, capSpace, totalCap);
        }).ToList();

        teamsOverCap = teamCapData.Count(r => r.CapSpace < 0);
    }

    private void GoToTeam(int id) => Navigation.NavigateTo($"/teams/{id}");

    private static string FormatMoney(decimal value)
    {
        if (value >= 1_000_000m) return $"${value / 1_000_000m:F1}M";
        if (value >= 1_000m) return $"${value / 1_000m:F0}K";
        if (value <= -1_000_000m) return $"-${Math.Abs(value) / 1_000_000m:F1}M";
        return value.ToString("C0");
    }
}
