@page "/free-agents"
@attribute [Authorize]
@implements IDisposable
@inject IDbContextFactory<DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FaOfferService FaOfferSvc

<PageTitle>Free Agents — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Free Agents</h1>
        @if (players != null)
        {
            <div class="subtitle">@totalPlayers available &middot; page @currentPage of @totalPages</div>
        }
    </div>
</div>

<div class="filter-bar bento-card mb-4">
    <div class="row g-3">
        <div class="col-12 col-sm-5 col-lg-4">
            <label>Search</label>
            <input type="text" class="form-control" placeholder="Player name..."
                   value="@searchName" @oninput="@(e => OnSearchInput(e.Value?.ToString() ?? ""))" />
        </div>
        <div class="col-6 col-sm-4 col-lg-3">
            <label>Position</label>
            <select class="form-select" @bind="filterPosition" @bind:after="OnFilterChanged">
                <option value="">All Positions</option>
                @foreach (var pos in positions)
                {
                    <option value="@pos.Code">@pos.Code — @pos.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-3 col-lg-3">
            <label>Interest</label>
            <select class="form-select" @bind="filterHeat" @bind:after="OnFilterChanged">
                <option value="0">All</option>
                <option value="1">Has offers</option>
                <option value="2">Hot (2+ offers)</option>
                <option value="4">Blazing (4+ offers)</option>
            </select>
        </div>
    </div>
</div>

@if (players == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading free agents...
    </div>
}
else if (!players.Any())
{
    <div class="empty-state">
        <i class="bi bi-person-plus"></i>
        <p>No free agents found matching your filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="dm-table">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Pos</th>
                    <th class="d-none d-sm-table-cell">Age</th>
                    <th class="d-none d-sm-table-cell">Last Team</th>
                    <th>Market Interest</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in players)
                {
                    var heat = heatMap.TryGetValue(p.Id, out var h) ? h : null;
                    var lastContract = p.Contracts.OrderByDescending(c => c.Id).FirstOrDefault();
                    <tr class="row-link" @onclick="@(() => GoToPlayer(p.Id))">
                        <td>
                            <span class="t-name">@p.FirstName @p.LastName</span>
                        </td>
                        <td><span class="@PosBadgeClass(p.Position?.Code)">@(p.Position?.Code ?? "—")</span></td>
                        <td class="d-none d-sm-table-cell t-sub">@(p.Age.HasValue ? p.Age.ToString() : "—")</td>
                        <td class="d-none d-sm-table-cell t-sub">
                            @(lastContract?.ContractYears.OrderByDescending(cy => cy.Year).FirstOrDefault()?.Team?.Abbreviation ?? "—")
                        </td>
                        <td>
                            @if (heat != null && heat.OfferCount > 0)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="heat-badge @heat.HeatClass">@heat.HeatLabel</span>
                                    <span class="heat-range">@heat.RangeLabel</span>
                                </div>
                            }
                            else
                            {
                                <span class="heat-badge heat-cold">No offers</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (isGm)
                            {
                                var myOffer = myOffers.TryGetValue(p.Id, out var mo) ? mo : null;
                                @if (myOffer != null)
                                {
                                    <span class="t-tiny" style="color:var(--dm-gold);">Offered</span>
                                }
                            }
                            <button class="dm-btn-ghost dm-btn-sm ms-1" @onclick:stopPropagation="true"
                                    @onclick="@(() => GoToPlayer(p.Id))">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
        <div class="dm-pagination">
            <button @onclick="@(async () => await SetPage(1))" disabled="@(currentPage == 1)">«</button>
            <button @onclick="@(async () => await SetPage(currentPage - 1))" disabled="@(currentPage == 1)">‹</button>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                int pageNum = i;
                <button class="@(currentPage == pageNum ? "active" : "")" @onclick="@(async () => await SetPage(pageNum))">@pageNum</button>
            }
            <button @onclick="@(async () => await SetPage(currentPage + 1))" disabled="@(currentPage == totalPages)">›</button>
            <button @onclick="@(async () => await SetPage(totalPages))" disabled="@(currentPage == totalPages)">»</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span style="font-size: 0.8rem; color: var(--dm-text-muted);">Per page:</span>
            <select class="form-select form-select-sm w-auto" @bind="pageSize" @bind:after="OnPageSizeChangedAsync">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
}

@code {
    private List<Player>? players;
    private List<Position> positions = new();
    private Dictionary<int, FaHeatDto> heatMap = new();
    private Dictionary<int, FaOffer> myOffers = new();
    private Timer? _debounceTimer;

    private string searchName     = "";
    private string filterPosition = "";
    private int    filterHeat;
    private int    currentPage   = 1;
    private int    pageSize      = 25;
    private int    totalPlayers;
    private int    totalPages;

    private bool isGm;
    private int  myTeamId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isGm = user.IsInRole("GM") || user.IsInRole("Assistant GM");
        if (isGm && int.TryParse(user.FindFirst("TeamId")?.Value, out var tid))
            myTeamId = tid;

        using var db = await DbFactory.CreateDbContextAsync();
        positions = await db.Positions.OrderBy(p => p.DisplayOrder).AsNoTracking().ToListAsync();
        await LoadPlayersAsync();
    }

    private void OnSearchInput(string value)
    {
        searchName = value;
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadPlayersAsync();
            StateHasChanged();
        }), null, 300, Timeout.Infinite);
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task LoadPlayersAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Build base query
        var query = db.Players
            .Where(p => p.TeamId == null && !p.IsRetired)
            .Include(p => p.Position)
            .Include(p => p.Contracts).ThenInclude(c => c.ContractYears).ThenInclude(cy => cy.Team)
            .AsNoTracking()
            .AsQueryable();

        if (!string.IsNullOrEmpty(searchName))
            query = query.Where(p =>
                EF.Functions.Like(p.FirstName, $"%{searchName}%") ||
                EF.Functions.Like(p.LastName,  $"%{searchName}%"));

        if (!string.IsNullOrEmpty(filterPosition))
            query = query.Where(p => p.Position.Code == filterPosition);

        // Heat filter: need offer counts — pull all FA IDs and filter in memory for simplicity
        // (heat filter only applied after pulling page if filterHeat > 0)
        totalPlayers = await query.CountAsync();
        totalPages   = Math.Max(1, (totalPlayers + pageSize - 1) / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;

        var pageQuery = query
            .OrderBy(p => p.Position != null ? p.Position.DisplayOrder : 99)
            .ThenBy(p => p.LastName)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

        players = await pageQuery.ToListAsync();

        // Load heat batch for this page
        var pageIds = players.Select(p => p.Id).ToList();
        heatMap = pageIds.Count > 0 ? await FaOfferSvc.GetHeatBatchAsync(pageIds) : new();

        // Apply heat filter client-side (after page load)
        if (filterHeat > 0)
        {
            players = players.Where(p =>
            {
                var count = heatMap.TryGetValue(p.Id, out var h) ? h.OfferCount : 0;
                return count >= filterHeat;
            }).ToList();
        }

        // Load GM's own offers for this page
        if (isGm && myTeamId > 0 && pageIds.Count > 0)
        {
            using var db2 = await DbFactory.CreateDbContextAsync();
            var offers = await db2.FaOffers
                .Where(o => o.TeamId == myTeamId && pageIds.Contains(o.PlayerId) && o.Status == FaOfferStatus.Active)
                .ToListAsync();
            myOffers = offers.ToDictionary(o => o.PlayerId);
        }
        else
        {
            myOffers = new();
        }
    }

    private async Task OnPageSizeChangedAsync()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task SetPage(int page)
    {
        if (page >= 1 && page <= totalPages) { currentPage = page; await LoadPlayersAsync(); }
    }

    public void Dispose() => _debounceTimer?.Dispose();

    private void GoToPlayer(int playerId) => Navigation.NavigateTo($"/players/{playerId}");
}
