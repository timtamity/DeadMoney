@page "/"

<PageTitle>Home — Dead Money</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="bento-card text-center py-5 mt-2">
            <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: var(--dm-gold);"></i>
            <h3 class="mt-3">Welcome to Dead Money</h3>
            <p style="color: var(--dm-text-muted); max-width: 380px; margin: 0 auto 1.5rem;">
                Sign in with your Discord account to access the league portal.
            </p>
            <a href="login" class="dm-btn-primary">
                <i class="bi bi-discord"></i> Login with Discord
            </a>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="page-header">
            <div>
                <h1>Dashboard</h1>
                <div class="subtitle">Welcome back, @(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</div>
            </div>
        </div>

        <p style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--dm-text-muted); margin-bottom: 0.6rem;">
            Quick Access
        </p>
        <div class="quick-nav-grid">
            <a href="/teams" class="quick-nav-card">
                <i class="bi bi-flag-fill"></i>
                <span>Teams</span>
            </a>
            <a href="/players" class="quick-nav-card">
                <i class="bi bi-people-fill"></i>
                <span>Players</span>
            </a>
            <a href="/contracts" class="quick-nav-card">
                <i class="bi bi-file-earmark-text-fill"></i>
                <span>Contracts</span>
            </a>
            <a href="/free-agents" class="quick-nav-card">
                <i class="bi bi-person-plus-fill"></i>
                <span>Free Agents</span>
            </a>
            <a href="/salary-cap" class="quick-nav-card">
                <i class="bi bi-bank2"></i>
                <span>Salary Cap</span>
            </a>
            <AuthorizeView Roles="Admin, GM, Assistant GM, Commissioner" Context="innerCtx">
                <Authorized>
                    <a href="/roster" class="quick-nav-card">
                        <i class="bi bi-clipboard2-check-fill"></i>
                        <span>My Roster</span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="dm-alert dm-alert-info d-flex align-items-center gap-3">
            <i class="bi bi-info-circle-fill" style="font-size: 1.4rem; flex-shrink: 0;"></i>
            <div>
                <div style="font-weight: 600; color: var(--dm-text-bright);">Offseason in progress</div>
                <div style="font-size: 0.85rem; margin-top: 2px;">
                    Manage your roster, sign free agents, and track salary cap space.
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
