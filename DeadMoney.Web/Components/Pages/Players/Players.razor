@page "/players"
@implements IDisposable
@inject IDbContextFactory<DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject LeagueSettingsService LeagueSettingsSvc

<PageTitle>Players — Dead Money</PageTitle>

<div class="page-header">
    <div>
        <h1>Players</h1>
        @if (players != null)
        {
            <div class="subtitle">@totalPlayers players &middot; page @currentPage of @totalPages</div>
        }
    </div>
</div>

<div class="filter-bar bento-card mb-4">
    <div class="row g-3">
        <div class="col-12 col-sm-4">
            <label>Search</label>
            <input type="text" class="form-control" placeholder="Player name..." value="@searchName"
                   @oninput="@(e => OnSearchInput(e.Value?.ToString() ?? ""))" />
        </div>
        <div class="col-6 col-sm-4">
            <label>Position</label>
            <select class="form-select" @bind="filterPosition" @bind:after="OnFilterChanged">
                <option value="">All Positions</option>
                @foreach (var pos in positions)
                {
                    <option value="@pos.Code">@pos.Code — @pos.Name</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-4">
            <label>Team</label>
            <select class="form-select" @bind="filterTeam" @bind:after="OnFilterChanged">
                <option value="">All Teams</option>
                @foreach (var team in teams)
                {
                    <option value="@team.Abbreviation">@team.Abbreviation — @team.City</option>
                }
            </select>
        </div>
    </div>
</div>

@if (players == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading players...
    </div>
}
else if (!players.Any())
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <p>No players found matching your filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="dm-table">
            <thead>
                <tr>
                    <th class="sortable" @onclick="@(async () => await SortAndLoad("Name"))">
                        Player @GetSortIndicator("Name")
                    </th>
                    <th class="sortable" @onclick="@(async () => await SortAndLoad("Team"))">
                        Team @GetSortIndicator("Team")
                    </th>
                    <th class="sortable" @onclick="@(async () => await SortAndLoad("Position"))">
                        Pos @GetSortIndicator("Position")
                    </th>
                    <th class="text-end d-none d-sm-table-cell">@currentYear Cap</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in players)
                {
                    <tr class="row-link" @onclick="@(() => GoToPlayer(p.Id))">
                        <td>
                            <span class="t-name">@p.FirstName @p.LastName</span>
                            @if (!string.IsNullOrEmpty(p.Number))
                            {
                                <span class="t-jersey">#@p.Number</span>
                            }
                        </td>
                        <td class="t-sub">@(p.Team?.Abbreviation ?? "FA")</td>
                        <td><span class="@PosBadgeClass(p.Position?.Code)">@(p.Position?.Code ?? "—")</span></td>
                        <td class="text-end t-money d-none d-sm-table-cell">
                            @(_capHitByPlayer.TryGetValue(p.Id, out var ch) && ch > 0 ? FormatMoney(ch) : "—")
                        </td>
                        <td class="text-end">
                            <button class="dm-btn-ghost dm-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => GoToPlayer(p.Id))">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
        <div class="dm-pagination">
            <button @onclick="@(async () => await SetPage(1))" disabled="@(currentPage == 1)">«</button>
            <button @onclick="@(async () => await SetPage(currentPage - 1))" disabled="@(currentPage == 1)">‹</button>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                int pageNum = i;
                <button class="@(currentPage == pageNum ? "active" : "")" @onclick="@(async () => await SetPage(pageNum))">@pageNum</button>
            }
            <button @onclick="@(async () => await SetPage(currentPage + 1))" disabled="@(currentPage == totalPages)">›</button>
            <button @onclick="@(async () => await SetPage(totalPages))" disabled="@(currentPage == totalPages)">»</button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="t-label">Per page:</span>
            <select class="form-select form-select-sm w-auto" @bind="pageSize" @bind:after="OnPageSizeChangedAsync">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
}

@code {
    private List<Player>? players;
    private List<Position> positions = new();
    private List<Team> teams = new();
    private Dictionary<int, decimal> _capHitByPlayer = new();
    private Timer? _debounceTimer;

    private string searchName = "";
    private string filterPosition = "";
    private string filterTeam = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPlayers = 0;
    private int totalPages = 0;
    private int currentYear;

    protected override async Task OnInitializedAsync()
    {
        currentYear = await LeagueSettingsSvc.GetCurrentYearAsync();
        using var db = await DbFactory.CreateDbContextAsync();
        positions = await db.Positions.OrderBy(p => p.DisplayOrder).AsNoTracking().ToListAsync();
        teams     = await db.Teams.OrderBy(t => t.Abbreviation).AsNoTracking().ToListAsync();
        await LoadPlayersAsync();
    }

    private void OnSearchInput(string value)
    {
        searchName = value;
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadPlayersAsync();
            StateHasChanged();
        }), null, 300, Timeout.Infinite);
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task LoadPlayersAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.Players
            .Include(p => p.Team)
            .Include(p => p.Position)
            .AsNoTracking()
            .AsQueryable();

        if (!string.IsNullOrEmpty(searchName))
            query = query.Where(p =>
                EF.Functions.Like(p.FirstName, $"%{searchName}%") ||
                EF.Functions.Like(p.LastName, $"%{searchName}%"));

        if (!string.IsNullOrEmpty(filterPosition))
            query = query.Where(p => p.Position.Code == filterPosition);

        if (!string.IsNullOrEmpty(filterTeam))
            query = query.Where(p => p.Team != null && p.Team.Abbreviation == filterTeam);

        totalPlayers = await query.CountAsync();
        totalPages = Math.Max(1, (totalPlayers + pageSize - 1) / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;

        query = sortColumn switch
        {
            "Team"     => sortAscending ? query.OrderBy(p => p.Team != null ? p.Team.Abbreviation : "") : query.OrderByDescending(p => p.Team != null ? p.Team.Abbreviation : ""),
            "Position" => sortAscending ? query.OrderBy(p => p.Position != null ? p.Position.Code : "") : query.OrderByDescending(p => p.Position != null ? p.Position.Code : ""),
            _          => sortAscending ? query.OrderBy(p => p.LastName).ThenBy(p => p.FirstName) : query.OrderByDescending(p => p.LastName).ThenByDescending(p => p.FirstName)
        };

        players = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();

        if (players.Any())
        {
            var ids = players.Select(p => p.Id).ToList();
            _capHitByPlayer = await db.Contracts
                .Where(c => c.IsActive && ids.Contains(c.PlayerId))
                .Select(c => new {
                    c.PlayerId,
                    CapHit = c.ContractYears.Where(cy => cy.Year == currentYear).Sum(cy => cy.CapNumber)
                })
                .Where(x => x.CapHit > 0)
                .ToDictionaryAsync(x => x.PlayerId, x => x.CapHit);
        }
        else
        {
            _capHitByPlayer = new();
        }
    }

    private async Task SortAndLoad(string column)
    {
        sortAscending = sortColumn == column ? !sortAscending : true;
        sortColumn = column;
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task OnPageSizeChangedAsync()
    {
        currentPage = 1;
        await LoadPlayersAsync();
    }

    private async Task SetPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadPlayersAsync();
        }
    }

    private string GetSortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortAscending ? " ▲" : " ▼";
    }

    private void GoToPlayer(int playerId) => Navigation.NavigateTo($"/players/{playerId}");

    public void Dispose() => _debounceTimer?.Dispose();
}
