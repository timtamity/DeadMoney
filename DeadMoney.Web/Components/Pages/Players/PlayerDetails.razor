@page "/players/{playerId:int}"
@using Microsoft.AspNetCore.Components
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDbContextFactory<DeadMoney.Data.DeadMoneyDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FaOfferService FaOfferSvc

<PageTitle>@(player != null ? $"{player.FirstName} {player.LastName}" : "Player") — Dead Money</PageTitle>

<div class="mb-3">
    <button class="dm-btn-ghost" @onclick="@(() => Navigation.NavigateTo("/players"))">
        <i class="bi bi-arrow-left"></i> Players
    </button>
</div>

@if (player == null)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-secondary me-2"></div>
        Loading player...
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>
                @player.FirstName @player.LastName
                @if (!string.IsNullOrEmpty(player.Number))
                {
                    <span style="color: var(--dm-text-muted); font-weight: 400; font-size: 1.1rem; margin-left: 8px;">#@player.Number</span>
                }
            </h1>
            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                <span class="@PosBadgeClass(player.Position?.Code)">@(player.Position?.Code ?? "—")</span>
                @if (player.Team != null)
                {
                    <span style="color: var(--dm-text-muted); font-size: 0.875rem;">
                        <i class="bi bi-flag-fill me-1"></i>
                        <a href="/teams/@player.Team.Id" style="color: var(--dm-text-muted);">@player.Team.Abbreviation — @player.Team.City @player.Team.Name</a>
                    </span>
                }
                else
                {
                    <span style="color: var(--dm-warning); font-size: 0.875rem;"><i class="bi bi-person-plus me-1"></i>Free Agent</span>
                }
            </div>
        </div>
    </div>

    <!-- Player Bio -->
    <div class="stats-row mb-4">
        @if (!string.IsNullOrEmpty(player.College))
        {
            <div class="stat-card">
                <div class="stat-label">College</div>
                <div class="stat-value" style="font-size: 1rem;">@player.College</div>
            </div>
        }
        @if (player.Age.HasValue)
        {
            <div class="stat-card">
                <div class="stat-label">Age</div>
                <div class="stat-value">@player.Age</div>
            </div>
        }
        @if (player.DraftYear.HasValue)
        {
            <div class="stat-card">
                <div class="stat-label">Draft</div>
                <div class="stat-value" style="font-size: 1rem;">
                    @player.DraftYear Rd @(player.DraftRound ?? 0) Pk @(player.DraftPick ?? 0)
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(player.YearsExp))
        {
            <div class="stat-card">
                <div class="stat-label">Experience</div>
                <div class="stat-value" style="font-size: 1rem;">@player.YearsExp yrs</div>
            </div>
        }
    </div>

    <!-- FA Offers section (free agents only) -->
    @if (player.TeamId == null && !player.IsRetired)
    {
        <div class="bento-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="section-title mb-0">Market Interest</h2>
                @if (heat != null)
                {
                    <span class="heat-badge @heat.HeatClass">@heat.HeatLabel</span>
                }
            </div>

            @if (heat == null || heat.OfferCount == 0)
            {
                <p class="t-sub" style="margin: 0;">No offers on file yet.</p>
            }
            else
            {
                <!-- Range bar -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <span class="t-tiny">APY Range</span>
                        <span class="heat-range">@heat.RangeLabel</span>
                    </div>
                    <div class="offer-range-bar">
                        <div class="offer-range-fill"></div>
                        @if (myOffer != null)
                        {
                            <div class="offer-marker" style="left: @(heat.CompetitivenessPercent(myOffer.AnnualValueM))%;"></div>
                        }
                    </div>
                    <div class="offer-range-labels">
                        <span>$@heat.MinApyM.ToString("F1")M/yr</span>
                        @if (heat.MinApyM != heat.MaxApyM)
                        {
                            <span>Avg $@heat.AvgApyM.ToString("F1")M/yr</span>
                            <span>$@heat.MaxApyM.ToString("F1")M/yr</span>
                        }
                    </div>
                </div>
            }

            <!-- GM's own offer -->
            @if (isGmOrAbove)
            {
                <hr style="border-color: var(--dm-border); margin: 1rem 0;" />

                @if (myOffer != null)
                {
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
                        <div>
                            <div class="t-tiny mb-1">Your Offer</div>
                            <span style="font-weight: 700; color: var(--dm-text-bright); font-size: 1rem;">
                                @myOffer.Years yr / $@myOffer.TotalValueM.ToString("F1")M
                            </span>
                            <span class="t-sub ms-2">$@myOffer.AnnualValueM.ToString("F1")M/yr · $@myOffer.GuaranteedM.ToString("F1")M gtd</span>
                            @if (heat != null && heat.OfferCount > 1)
                            {
                                <span class="ms-2 t-tiny" style="color: @(myOffer.AnnualValueM >= heat.AvgApyM * 1.05m ? "var(--dm-success)" : myOffer.AnnualValueM <= heat.AvgApyM * 0.95m ? "var(--dm-danger)" : "var(--dm-gold)");">
                                    @heat.CompetitivenessLabel(myOffer.AnnualValueM)
                                </span>
                            }
                        </div>
                        <button class="dm-btn-ghost dm-btn-sm" style="color:var(--dm-danger);"
                                @onclick="WithdrawOfferAsync">
                            <i class="bi bi-x-circle me-1"></i>Withdraw
                        </button>
                    </div>
                    <!-- Update form -->
                    <div class="d-flex gap-2 flex-wrap align-items-end">
                        <div>
                            <div class="t-tiny mb-1">Years</div>
                            <select class="form-select form-select-sm" style="width:90px;" @bind="offerYears">
                                @for (int y = 1; y <= 5; y++) { <option value="@y">@y yr</option> }
                            </select>
                        </div>
                        <div>
                            <div class="t-tiny mb-1">Total ($M)</div>
                            <input type="number" class="form-control form-control-sm" style="width:110px;"
                                   @bind="offerTotalM" min="0.1" step="0.5" />
                        </div>
                        <div>
                            <div class="t-tiny mb-1">Gtd ($M)</div>
                            <input type="number" class="form-control form-control-sm" style="width:110px;"
                                   @bind="offerGuaranteedM" min="0" step="0.5" />
                        </div>
                        <button class="dm-btn-outline dm-btn-sm" @onclick="SubmitOfferAsync" disabled="@isBusy">
                            Update Offer
                        </button>
                    </div>
                }
                else if (!isAdminOrCommish)
                {
                    <div class="t-tiny mb-2">Submit Offer</div>
                    <div class="d-flex gap-2 flex-wrap align-items-end">
                        <div>
                            <div class="t-tiny mb-1">Years</div>
                            <select class="form-select form-select-sm" style="width:90px;" @bind="offerYears">
                                @for (int y = 1; y <= 5; y++) { <option value="@y">@y yr</option> }
                            </select>
                        </div>
                        <div>
                            <div class="t-tiny mb-1">Total ($M)</div>
                            <input type="number" class="form-control form-control-sm" style="width:110px;"
                                   @bind="offerTotalM" min="0.1" step="0.5" />
                        </div>
                        <div>
                            <div class="t-tiny mb-1">Gtd ($M)</div>
                            <input type="number" class="form-control form-control-sm" style="width:110px;"
                                   @bind="offerGuaranteedM" min="0" step="0.5" />
                        </div>
                        <button class="dm-btn-outline dm-btn-sm" @onclick="SubmitOfferAsync" disabled="@isBusy">
                            <i class="bi bi-send me-1"></i>Make Offer
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(offerMsg))
                    {
                        <div class="t-sub mt-2" style="color: var(--dm-success);">@offerMsg</div>
                    }
                }

                <!-- Admin: all offers table -->
                @if (isAdminOrCommish && allOffers.Count > 0)
                {
                    <div class="table-responsive mt-3">
                        <table class="dm-table">
                            <thead>
                                <tr>
                                    <th>Team</th>
                                    <th>Years</th>
                                    <th style="text-align:right;">Total</th>
                                    <th style="text-align:right;">APY</th>
                                    <th style="text-align:right;">Gtd</th>
                                    <th class="text-end">Submitted</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in allOffers)
                                {
                                    <tr>
                                        <td style="font-weight:600;color:var(--dm-text-bright);">@(o.Team?.Abbreviation ?? "—")</td>
                                        <td class="t-sub">@o.Years yr</td>
                                        <td class="text-end" style="color:var(--dm-gold);font-weight:600;">$@o.TotalValueM.ToString("F1")M</td>
                                        <td class="text-end t-sub">$@o.AnnualValueM.ToString("F1")M/yr</td>
                                        <td class="text-end t-sub">$@o.GuaranteedM.ToString("F1")M</td>
                                        <td class="text-end t-sub">@Relative(o.SubmittedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (isAdminOrCommish)
                {
                    <p class="t-sub mt-2" style="margin:0;">No offers submitted yet.</p>
                }
            }
        </div>
    }

    <!-- Contracts -->
    <h2 class="section-title">
        Contracts
        <span class="section-title-meta">(@player.Contracts.Count total)</span>
    </h2>

    @if (!player.Contracts.Any())
    {
        <div class="empty-state">
            <i class="bi bi-file-earmark-text"></i>
            <p>No contracts on file.</p>
        </div>
    }
    else
    {
        @foreach (var c in player.Contracts.OrderByDescending(c => c.IsActive))
        {
            <div class="bento-card mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <span style="color: var(--dm-text-bright); font-weight: 700; font-size: 1rem;">
                            @c.ContractYears.Count(y => !y.IsVoidYear)-Year Deal
                        </span>
                        @if (!c.IsActive)
                        {
                            <span class="t-tiny ms-2">Inactive</span>
                        }
                        @if (c.IsModifiedBySim)
                        {
                            <span class="sim-tag">✦ Sim Modified</span>
                        }
                    </div>
                    <button class="dm-btn-ghost dm-btn-sm" @onclick="@(() => GoToContract(c.Id))">
                        View Full Contract <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-label">Total Value</div>
                        <div class="stat-value gold" style="font-size: 1.1rem;">@FormatMoney(c.TotalValue)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Guaranteed</div>
                        <div class="stat-value" style="font-size: 1.1rem;">@FormatMoney(c.TotalGuaranteed)</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Signing Bonus</div>
                        <div class="stat-value" style="font-size: 1.1rem;">@FormatMoney(c.SigningBonus)</div>
                    </div>
                </div>

                @if (c.ContractYears.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="dm-table">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Team</th>
                                    <th style="text-align:right;">Base</th>
                                    <th style="text-align:right;">Cap Hit</th>
                                    <th style="text-align:right;" class="d-none d-sm-table-cell">Guaranteed</th>
                                    <th style="text-align:center;" class="d-none d-sm-table-cell">Void</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in c.ContractYears.OrderBy(cy => cy.Year))
                                {
                                    <tr style="@(y.IsVoidYear ? "opacity: 0.5;" : "")">
                                        <td style="font-weight: 600; color: var(--dm-text-bright);">@y.Year</td>
                                        <td style="color: var(--dm-text-muted); font-size: 0.85rem;">@(y.Team?.Abbreviation ?? "—")</td>
                                        <td style="text-align:right;">@FormatMoney(y.BaseSalary)</td>
                                        <td style="text-align:right; font-weight: 700; color: var(--dm-gold);">@FormatMoney(y.CapNumber)</td>
                                        <td style="text-align:right;" class="d-none d-sm-table-cell">@FormatMoney(y.GuaranteedAmount)</td>
                                        <td style="text-align:center;" class="d-none d-sm-table-cell">
                                            @if (y.IsVoidYear) { <span style="color: var(--dm-text-muted);">Void</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
}

@code {
    [Parameter] public int playerId { get; set; }

    private Player? player;

    // Role state
    private bool isGmOrAbove;
    private bool isAdminOrCommish;
    private int  myTeamId;

    // Offer state
    private FaHeatDto?  heat;
    private FaOffer?    myOffer;
    private List<FaOffer> allOffers = new();
    private int     offerYears       = 3;
    private decimal offerTotalM      = 10m;
    private decimal offerGuaranteedM = 5m;
    private bool    isBusy;
    private string  offerMsg = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdminOrCommish = user.IsInRole("Admin") || user.IsInRole("Commissioner");
        isGmOrAbove = isAdminOrCommish || user.IsInRole("GM") || user.IsInRole("Assistant GM");
        if (isGmOrAbove && !isAdminOrCommish && int.TryParse(user.FindFirst("TeamId")?.Value, out var tid))
            myTeamId = tid;

        using var db = await DbFactory.CreateDbContextAsync();
        player = await db.Players
            .Include(p => p.Position)
            .Include(p => p.Team)
            .Include(p => p.Contracts)
                .ThenInclude(c => c.ContractYears)
                    .ThenInclude(cy => cy.Team)
            .FirstOrDefaultAsync(p => p.Id == playerId);

        if (player?.TeamId == null && player?.IsRetired == false)
            await LoadOfferDataAsync();
    }

    private async Task LoadOfferDataAsync()
    {
        heat = await FaOfferSvc.GetHeatAsync(playerId);

        if (isGmOrAbove && !isAdminOrCommish && myTeamId > 0)
        {
            myOffer = await FaOfferSvc.GetMyOfferAsync(myTeamId, playerId);
            if (myOffer != null)
            {
                offerYears       = myOffer.Years;
                offerTotalM      = myOffer.TotalValueM;
                offerGuaranteedM = myOffer.GuaranteedM;
            }
        }

        if (isAdminOrCommish)
            allOffers = await FaOfferSvc.GetOffersForPlayerAsync(playerId);
    }

    private async Task SubmitOfferAsync()
    {
        if (offerTotalM <= 0 || offerYears <= 0 || myTeamId == 0) return;
        isBusy = true; offerMsg = "";
        myOffer = await FaOfferSvc.SubmitOrUpdateAsync(myTeamId, playerId, offerYears, offerTotalM, offerGuaranteedM);
        heat = await FaOfferSvc.GetHeatAsync(playerId);
        offerMsg = "Offer submitted.";
        isBusy = false;
    }

    private async Task WithdrawOfferAsync()
    {
        if (myOffer == null) return;
        isBusy = true;
        await FaOfferSvc.WithdrawAsync(myOffer.Id, myTeamId);
        myOffer = null;
        heat = await FaOfferSvc.GetHeatAsync(playerId);
        isBusy = false;
    }

    private void GoToContract(int contractId) => Navigation.NavigateTo($"/contracts/{contractId}");

    private static string Relative(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)   return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

    private static string FormatMoney(decimal value) =>
        value >= 1_000_000m ? $"${value / 1_000_000m:F1}M" :
        value >= 1_000m     ? $"${value / 1_000m:F0}K" :
        value.ToString("C0");
}
