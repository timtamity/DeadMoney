@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using DeadMoney.Core.Entities
@using DeadMoney.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<DeadMoneyDbContext> DbFactory

<PageTitle>My Profile - Dead Money</PageTitle>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        @if (!string.IsNullOrEmpty(_user?.AvatarUrl))
        {
            <img src="@_user.AvatarUrl" alt="Avatar" class="rounded-circle me-3" style="width: 80px; height: 80px; border: 2px solid #444;" />
        }
        <div>
            <h1 class="mb-0">@(_user?.DisplayName ?? "User Profile")</h1>
            <p class="text-muted">@_user?.Username</p>
        </div>
    </div>

    <hr />

    @if (_user == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Fetching your stats from the grid...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white">
                        Account Details
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong>Discord ID:</strong> <span class="text-muted small">@_user.DiscordId</span>
                        </li>
                        <li class="list-group-item">
                            <strong>Preferred Timezone:</strong> @_user.TimeZoneId
                        </li>
                        <li class="list-group-item">
                            <strong>Theme:</strong> @_user.ThemePreference
                        </li>
                        <li class="list-group-item">
                            <strong>Member Since:</strong> @_user.CreatedAt.ToShortDateString()
                        </li>
                    </ul>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        Bio
                    </div>
                    <div class="card-body">
                        <p class="card-text">@(string.IsNullOrWhiteSpace(_user.Bio) ? "No bio provided." : _user.Bio)</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        Active Session Claims
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">These values are stored in your encrypted session cookie:</p>
                        <ul class="list-group list-group-flush">
                            @foreach (var claim in _claims)
                            {
                                <li class="list-group-item" style="font-size: 0.8rem;">
                                    <strong>@claim.Type:</strong> @claim.Value
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private User? _user;
    private IEnumerable<Claim> _claims = Enumerable.Empty<Claim>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        _claims = principal.Claims;

        // Get the internal UserId we stashed in the claims during login
        var userIdClaim = principal.FindFirst("UserId")?.Value;

        if (int.TryParse(userIdClaim, out var userId))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _user = await db.Users
                .AsNoTracking()
                .Include(u => u.UserRoles)
                    .ThenInclude(ur => ur.Role)
                .FirstOrDefaultAsync(u => u.Id == userId);
        }
    }
}