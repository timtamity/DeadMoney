@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@using DeadMoney.Web.Identity
@using DeadMoney.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Commish")]
@inject IPlayerSyncService SyncService

<PageTitle>Admin Dashboard - Dead Money</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">Admin Dashboard</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active">Commissioner Tools</li>
                </ol>
            </nav>
        </div>
        <span class="badge bg-success p-2">Commish Access Verified</span>
    </div>

    <div class="row">
        @* User Info Card *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small font-weight-bold">Active Commissioner</h6>
                    <div class="h5 mb-0 font-weight-bold">@_displayName</div>
                    <hr />
                    <p class="text-muted small">Your Discord ID is linked to the Commish role. You have full access to system sync tools.</p>
                </div>
            </div>
        </div>

        @* Player Sync Card *@
        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-dark">Sleeper Data Management</h6>
                </div>
                <div class="card-body">
                    <p>Trigger a manual sync with the Sleeper API to update the player database. This will update names, teams, and retirement status for all NFL players in the <code>League</code> schema.</p>

                    <button class="btn btn-warning shadow-sm" @onclick="SyncPlayers" disabled="@_isSyncing">
                        @if (_isSyncing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">Syncing Players...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-1"></i>
                            <span>Sync Sleeper Players</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(_syncStatus))
                    {
                        <div class="mt-3 alert alert-info border-0 shadow-sm d-flex align-items-center">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>@_syncStatus</div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light text-muted small">
                    Note: This process updates the local <code>League.Players</code> table using the Sleeper NFL Master File.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _displayName;
    private bool _isSyncing = false;
    private string? _syncStatus;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            _displayName = authState.User.Identity?.Name ?? "Unknown Admin";
        }
    }

    private async Task SyncPlayers()
    {
        _isSyncing = true;
        _syncStatus = "Requesting data from Sleeper API...";

        try
        {
            // Executing the player sync from the injected Service
            await SyncService.SyncPlayersAsync();
            _syncStatus = $"Sync complete! Player database updated at {DateTime.Now.ToShortTimeString()}.";
        }
        catch (Exception ex)
        {
            _syncStatus = $"Error during sync: {ex.Message}";
        }
        finally
        {
            _isSyncing = false;
        }
    }
}