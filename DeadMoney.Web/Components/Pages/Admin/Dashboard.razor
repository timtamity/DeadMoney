@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@using DeadMoney.Web.Identity
@attribute [Authorize]
@inject IdentityUserAccessor UserAccessor
@inject HttpContext HttpContext

<PageTitle>Admin Dashboard - Dead Money</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Admin Dashboard</h1>
        <span class="badge bg-primary">System Online</span>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                        Current User</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@_userName</div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-dark">Data Management</h6>
                </div>
                <div class="card-body">
                    <p>Trigger a manual sync with the Sleeper API to update the player database.</p>
                    <button class="btn btn-warning" @onclick="SyncPlayers" disabled="@_isSyncing">
                        @(_isSyncing ? "Syncing..." : "Sync Sleeper Players")
                    </button>
                    @if (!string.IsNullOrEmpty(_syncStatus))
                    {
                        <div class="mt-3 alert alert-info">@_syncStatus</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _userName;
    private bool _isSyncing = false;
    private string? _syncStatus;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _userName = user.Email;
    }

    private async Task SyncPlayers()
    {
        _isSyncing = true;
        _syncStatus = "Connecting to Sleeper...";
        
        // This is where we'll hook into your SleeperPlayerSyncService later
        await Task.Delay(2000); // Simulate work
        
        _syncStatus = "Sync complete (Simulated).";
        _isSyncing = false;
    }
}