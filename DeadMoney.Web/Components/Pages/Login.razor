@page "/login"

<PageTitle>Login - Dead Money</PageTitle>

<div class="container text-center mt-5">
    <h1>Dead Money League</h1>
    <p class="lead">Sign in to access your dashboard.</p>

    <div class="card mx-auto shadow-sm" style="max-width: 400px;">
        <div class="card-body">
            <form action="Account/PerformExternalLogin" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="/" />

                <button type="submit" name="provider" value="Discord" class="btn btn-primary w-100 mb-2">
                    Login with Discord
                </button>

                <button type="submit" name="provider" value="Google" class="btn btn-outline-dark w-100">
                    Login with Google
                </button>
            </form>
        </div>
    </div>
</div>