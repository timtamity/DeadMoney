@inject NavigationManager Navigation

<!-- Mobile-only sidebar header -->
<div class="sidebar-top d-md-none">
    <div class="brand">DEAD MONEY</div>
</div>

<div class="nav-container">
    <div class="nav-scrollable">
        <nav class="flex-column">

            <div class="nav-section-label">General</div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill"></i> <span>Home</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="teams">
                    <i class="bi bi-flag-fill"></i> <span>Teams</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="players">
                    <i class="bi bi-people-fill"></i> <span>Players</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="contracts">
                    <i class="bi bi-file-earmark-text-fill"></i> <span>Contracts</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="free-agents">
                    <i class="bi bi-person-plus-fill"></i> <span>Free Agents</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="transactions">
                    <i class="bi bi-megaphone-fill"></i> <span>Transactions</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="salary-cap">
                    <i class="bi bi-bank2"></i> <span>Salary Cap</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="draft">
                    <i class="bi bi-mic-fill"></i> <span>Draft Room</span>
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin, GM, Assistant GM, Commissioner">
                <div class="nav-section-label">Front Office</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="roster">
                        <i class="bi bi-clipboard2-check-fill"></i> <span>My Roster</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="trade">
                        <i class="bi bi-arrow-left-right"></i> <span>Trade</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="proposals">
                        <i class="bi bi-hourglass-split"></i> <span>My Proposals</span>
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Commissioner">
                <div class="nav-section-label commissioner-label">Commissioner</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link commissioner-link" href="proposals">
                        <i class="bi bi-inbox-fill"></i> <span>Proposals</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link commissioner-link" href="commissioner/cap">
                        <i class="bi bi-currency-dollar"></i> <span>Cap Adjustments</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link commissioner-link" href="draft/setup">
                        <i class="bi bi-mic-fill"></i> <span>Draft Setup</span>
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Agent, Commissioner">
                <div class="nav-section-label">Agency</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-clients">
                        <i class="bi bi-briefcase-fill"></i> <span>My Clients</span>
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <div class="nav-section-label admin-label">Admin</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link admin-link" href="admin/league-settings">
                        <i class="bi bi-sliders"></i> <span>League Settings</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link admin-link" href="admin/users">
                        <i class="bi bi-person-gear"></i> <span>User Management</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link admin-link" href="admin/draft-picks">
                        <i class="bi bi-list-ol"></i> <span>Draft Picks</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link admin-link" href="admin/import">
                        <i class="bi bi-cloud-download-fill"></i> <span>Import Data</span>
                    </NavLink>
                </div>
            </AuthorizeView>

        </nav>
    </div>

    <AuthorizeView>
        <Authorized>
            <TransactionFeed Compact="true" />
        </Authorized>
    </AuthorizeView>

    <div class="nav-footer px-3">
        <NavLink class="nav-link" href="profile">
            <i class="bi bi-person-circle"></i> <span>Profile</span>
        </NavLink>
    </div>
</div>
