@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Capture where the user was trying to go
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Redirect to the login page.
        // We use forceLoad: true because Identity login is typically a
        // separate static page/controller and needs a full request.
        Navigation.NavigateTo($"Account/Login?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}