@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-bar px-4">
            <div class="brand">DEAD MONEY</div>

            <div class="user-auth">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-3 welcome-text">
                            Hello, @(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)!
                        </span>
                        <form action="logout" method="post" style="display:inline">
                            <AntiforgeryToken />
                            <button type="submit" class="dm-button-outline">
                                Logout
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="dm-button-primary">Log in with Discord</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <AuthorizeView Roles="Commissioner">
            <Authorized>
                <div class="commish-banner">
                    <i class="bi bi-shield-check me-2"></i> COMMISSIONER ACCESS ENABLED
                </div>
            </Authorized>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>