@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<DeadMoneyDbContext> DbFactory

<div class="page">
    <div class="sidebar @(menuOpen ? "open" : "")">
        <NavMenu />
    </div>

    @if (menuOpen)
    {
        <div class="menu-backdrop" @onclick="CloseMenu"></div>
    }

    <main>
        <header class="top-bar px-3 px-md-4" style="@headerStyle">
            <div class="d-flex align-items-center gap-2">
                <button class="hamburger-btn" @onclick="ToggleMenu" aria-label="Toggle menu">
                    <i class="bi @(menuOpen ? "bi-x-lg" : "bi-list")"></i>
                </button>
                <div class="brand">DEAD MONEY</div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <AuthorizeView Roles="Admin" Context="adminCtx">
                            <Authorized>
                                <span class="commish-indicator d-none d-sm-inline text-danger">
                                    <i class="bi bi-shield-fill"></i> ADMIN
                                </span>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Commissioner" Context="commCtx">
                            <Authorized>
                                <span class="commish-indicator d-none d-sm-inline">
                                    <i class="bi bi-shield-check"></i> COMMISH
                                </span>
                            </Authorized>
                        </AuthorizeView>

                        @if (showTeamBar)
                        {
                            <TeamBar TeamId="myTeamId" TeamAbbr="@teamAbbr" IsCommissioner="@isCommissioner" />
                        }

                        <span class="welcome-text d-none d-md-inline me-1">
                            @(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)
                        </span>
                        <form action="logout" method="post" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="dm-btn-outline dm-btn-sm">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-sm-inline">Logout</span>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="dm-btn-primary dm-btn-sm">
                            <i class="bi bi-discord"></i>
                            <span>Login</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content px-3 px-md-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool   menuOpen;
    private bool   showTeamBar;
    private bool   isCommissioner;
    private int    myTeamId;
    private string teamAbbr  = "";
    private string headerStyle = "";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!user.Identity?.IsAuthenticated ?? true) return;

        isCommissioner = user.IsInRole("Admin") || user.IsInRole("Commissioner");
        var isGmRole   = user.IsInRole("GM") || user.IsInRole("Assistant GM");

        int.TryParse(user.FindFirst("TeamId")?.Value, out myTeamId);

        showTeamBar = isCommissioner || isGmRole;

        if (myTeamId > 0)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var team = await db.Teams
                .Where(t => t.Id == myTeamId)
                .Select(t => new { t.Abbreviation, t.PrimaryColor })
                .AsNoTracking()
                .FirstOrDefaultAsync();

            if (team != null)
            {
                teamAbbr = team.Abbreviation;
                if (!string.IsNullOrEmpty(team.PrimaryColor))
                    headerStyle = $"--team-color: {team.PrimaryColor};";
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu()  => menuOpen = false;
}
